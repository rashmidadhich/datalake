# ==============================================================================
# Bronze Loader Environment Credentials (Template)
# ==============================================================================
# Copy this file to .env and replace placeholder values with actual credentials:
#   cp .env.example .env
# ==============================================================================

# Target Database: PostgreSQL
# Example: postgresql://postgres:password@lake-db.internal:5432/lake
PG_DSN="postgresql://<user>:<password>@<host>:5432/<dbname>"

# Source Databases: Oracle Zones (SZ, WZ, NZ, EZ)
# DSN format: <host>:<port>/<service_name>
ORA_SZ_DSN="<sz_host>:1521/<sz_service>"
ORA_SZ_USER="<sz_user>"
ORA_SZ_PASSWORD="<sz_password>"

ORA_WZ_DSN="<wz_host>:1521/<wz_service>"
ORA_WZ_USER="<wz_user>"
ORA_WZ_PASSWORD="<wz_password>"

ORA_NZ_DSN="<nz_host>:1521/<nz_service>"
ORA_NZ_USER="<nz_user>"
ORA_NZ_PASSWORD="<nz_password>"

ORA_EZ_DSN="<ez_host>:1521/<ez_service>"
ORA_EZ_USER="<ez_user>"
ORA_EZ_PASSWORD="<ez_password>"

